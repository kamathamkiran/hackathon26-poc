{
  "lowConfidenceThreshold": 0.70,
  "sections": {
    "deal": [
      { "field": "dealName", "label": "Deal Name", "mandatory": true, "type": "STRING", "maxLength": 40 },
      { "field": "currency", "label": "Currency", "mandatory": true, "type": "CURRENCY", "allowedValues": ["USD", "EUR", "GBP", "INR", "JPY", "CAD", "AUD", "CHF"] },
      { "field": "agreementDate", "label": "Agreement Date", "mandatory": true, "type": "DATE" },
      { "field": "globalDealProposedCommitmentAmount", "label": "Global Proposed Commitment","mandatory": true, "type": "AMOUNT", "positive": true },
      { "field": "department", "label": "Department", "mandatory": false, "type": "STRING", "maxLength": 40 },
      { "field": "branch", "label": "Branch", "mandatory": false, "type": "STRING", "maxLength": 40 },
      { "field": "processingAreaCode", "label": "Processing Area", "mandatory": false, "type": "STRING", "maxLength": 20 },
      { "field": "classification", "label": "Classification", "type": "STRING", "maxLength": 40 }
    ],
    "dealBorrower": [
      { "field": "borrowerName", "label": "Borrower Name", "mandatory": true, "type": "STRING", "maxLength": 100 }
    ],
    "dealAdminAgent": [
      { "field": "agentName", "label": "Admin Agent", "mandatory": true, "type": "STRING", "maxLength": 100 }
    ],
    "interestPricingOption": [
      { "field": "pricingOption", "label": "Interest Pricing Option", "mandatory": true, "type": "STRING", "maxLength": 30 }
    ],
    "facility": [
      { "field": "facilityName", "label": "Facility Name", "mandatory": true, "type": "STRING", "maxLength": 30 },
      { "field": "facilityType", "label": "Facility Type", "mandatory": true, "type": "STRING", "maxLength": 30 },
      { "field": "proposedCommitmentAmount", "label": "Proposed Commitment", "mandatory": true, "type": "AMOUNT", "positive": true },
      { "field": "closingCommitment", "label": "Closing Commitment","mandatory": true, "type": "AMOUNT", "nonNegative": true },
      { "field": "agreementDate", "label": "Facility Agreement Date", "mandatory": true,"type": "DATE" },
      { "field": "effectiveDate", "label": "Effective Date", "mandatory": true, "type": "DATE" },
      { "field": "expiryDate", "label": "Expiry Date", "mandatory": true, "type": "DATE" },
      { "field": "finalMaturityDate", "label": "Final Maturity Date", "mandatory": true, "type": "DATE" },
      { "field": "facilityInterestPricingList", "label": "Facility Pricing Option", "mandatory": true, "type": "ARRAY", "minItems": 1 }
    ],
    "facilitySublimit": [
      { "field": "name", "label": "Facility Sublimit Name",  "mandatory": true, "type": "STRING", "maxLength": 100 },
      { "field": "effectiveDate", "label": "Facility Sublimit Effective Date",  "mandatory": true, "type": "DATE" }
    ],
    "pricing": [
      { "field": "optionName", "label": "Pricing Option Name", "mandatory": true, "type": "STRING", "maxLength": 100 },
      { "field": "rateBasis", "label": "Rate Basis", "mandatory": true, "type": "STRING", "maxLength": 100 },
      { "field": "baseRate", "label": "Base Rate", "mandatory": true, "type": "STRING", "maxLength": 100 },
      { "field": "spread", "label": "Spread", "mandatory": true, "type": "AMOUNT", "nonNegative": true }
    ]
  }
}
